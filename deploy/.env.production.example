# Copy to deploy/.env.production and keep the copy private.
# Generate a stable APP_KEY once: base64: followed by 32 random bytes in base64.
APP_KEY=
APP_URL=https://your-domain.example
APP_PORT=8080
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Comma-separated IP addresses / CIDRs of your HTTPS reverse proxies.
# Never use * unless the origin is reachable only by your controlled proxy.
TRUSTED_PROXIES=
